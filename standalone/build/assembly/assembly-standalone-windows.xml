<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
	<id>standalone-windows</id>
	<formats>
		<format>zip</format>
	</formats>
	<includeBaseDirectory>true</includeBaseDirectory>
	<files>
		<file>
			<source>${project.build.directory}/${project.parent.artifactId}-${project.parent.version}.jar</source>
			<outputDirectory>lib</outputDirectory>
		</file>
	</files>
	<fileSets>
		<fileSet>
			<lineEnding>windows</lineEnding>
			<fileMode>0755</fileMode>
			<includes>
				<include>bin/*.bat</include>
			</includes>
		</fileSet>
		<fileSet>
			<includes>
				<include>doc/**</include>
			</includes>
		</fileSet>
		<fileSet>
			<directory>${project.parent.basedir}/standalone-server/src/main/resources</directory>
			<outputDirectory>etc</outputDirectory>
			<includes>
				<include>**/*</include>
			</includes>
		</fileSet>
		<fileSet>
			<directory>${project.build.directory}</directory>
			<outputDirectory>log</outputDirectory>
			<excludes>
				<exclude>**/*</exclude>
			</excludes>
		</fileSet>
	</fileSets>
	<dependencySets>
		<dependencySet>
			<outputDirectory>lib</outputDirectory>
			<excludes>
				<exclude>${project.groupId}:standalone-server</exclude>
			</excludes>
		</dependencySet>
	</dependencySets>
</assembly>